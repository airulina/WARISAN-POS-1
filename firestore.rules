rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function inviteMatch(inviteId, ownerUid, branchId) {
      return exists(/databases/$(database)/documents/staffInvites/$(inviteId))
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.branchId == branchId
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.active == true;
    }
    function member(ownerUid, branchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/members/$(request.auth.uid)).data.active == true;
    }

    // Backward-compatible Google backup for older single-store accounts.
    match /users/{uid}/warisanpos/{document} {
      allow read, write: if owner(uid);
    }
    match /workspaces/{ownerUid} {
      allow read: if owner(ownerUid);
      allow create: if owner(ownerUid)
        && request.resource.data.ownerUid == ownerUid;
      allow update, delete: if owner(ownerUid);

      match /branches/{branchId} {
        allow read: if owner(ownerUid) || member(ownerUid, branchId);
        allow create: if owner(ownerUid)
          && request.resource.data.ownerUid == ownerUid;
        allow update, delete: if owner(ownerUid);

        match /members/{userUid} {
          allow get, list: if owner(ownerUid) || (signedIn() && request.auth.uid == userUid);
          allow create: if owner(ownerUid) ||
            (verifiedEmail() && request.auth.uid == userUid
              && request.resource.data.uid == userUid
              && request.resource.data.email == request.auth.token.email
              && request.resource.data.role == 'STAFF'
              && request.resource.data.active == true
              && request.resource.data.invitationId is string
              && inviteMatch(request.resource.data.invitationId,ownerUid,branchId));
          allow update, delete: if owner(ownerUid);
        }
        match /live/{docId} {
          allow read: if owner(ownerUid) || member(ownerUid,branchId);
          allow create, update: if owner(ownerUid);
          allow delete: if false;
        }
        match /daily/{dayId} {
          allow read: if owner(ownerUid) || member(ownerUid,branchId);
          allow create, update: if owner(ownerUid) || member(ownerUid,branchId);
          allow delete: if false;
        }
        match /liveOrders/{orderId} {
          allow read: if owner(ownerUid) || member(ownerUid,branchId);
          allow create: if owner(ownerUid) || member(ownerUid,branchId);
          allow update: if owner(ownerUid) || member(ownerUid,branchId);
          allow delete: if false;
        }
        // Refund requests: staff may request; ONLY Owner may approve/deny.
        // Staff may claim an approved refund once and finalize its status.
        match /refundRequests/{requestId} {
          allow get, list: if owner(ownerUid) ||
            (member(ownerUid,branchId) && resource.data.employeeUid == request.auth.uid);
          allow create: if member(ownerUid,branchId)
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.employeeEmail == request.auth.token.email
            && request.resource.data.status == "PENDING"
            && request.resource.data.amount is int
            && request.resource.data.amount > 0
            && request.resource.data.businessDay is string
            && request.resource.data.saleFingerprint is string
            && request.resource.data.receipt is string
            && request.resource.data.keys().hasOnly([
              "ownerUid", "branchId", "employeeUid", "employeeEmail",
              "businessDay","saleFingerprint","receipt","amount","status","requestedAt"
            ]);
          allow update: if
            (owner(ownerUid)
              && resource.data.status == "PENDING"
              && request.resource.data.status in ["APPROVED", "DENIED"]
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","decidedBy","decidedAt"]))
            ||
            (member(ownerUid,branchId)
              && resource.data.employeeUid == request.auth.uid
              && resource.data.status == "APPROVED"
              && request.resource.data.status == "CLAIMED"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","claimedAt"]))
            ||
            (member(ownerUid,branchId)
              && resource.data.employeeUid == request.auth.uid
              && resource.data.status == "CLAIMED"
              && request.resource.data.status == "COMPLETED"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","completedAt"]));
          allow delete: if false;
        }
        // Only Owner can restore/overwrite a full POS backup.
        // Shared transactions will be introduced later as append-only documents.
        match /backups/{document} {
          allow read, write: if owner(ownerUid);
        }
      }
    }
    // Spark-only onboarding: Owner uses a secondary FirebaseAuth account to create
    // worker credentials, while writing a worker profile under Owner authorization.
    match /staffProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
        || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "STAFF"
        && request.resource.data.active == true
        && request.resource.data.email is string
        && request.resource.data.branchId is string
        && exists(/databases/$(database)/documents/workspaces/$(request.auth.uid)/branches/$(request.resource.data.branchId))
        && request.resource.data.keys().hasOnly([
          "uid","email","role","active","ownerUid",
          "branchId","branchName","createdAt"]);
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == "STAFF"
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active"]);
      allow delete: if false;
    }
    // Legacy Gmail invitation creation is disabled for new deployments.
    // Staff accounts must be provisioned by an authenticated Owner through Cloud Functions.
    match /staffInvites/{inviteId} {
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
        resource.data.email == request.auth.token.email);
      allow create, update, delete: if false;
    }
  }
}