rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function malaysiaDate(daysBack) {
      let t=request.time + duration.value(8,'h') - duration.value(daysBack,'d');
      return string(t.year())+"-"+(t.month()<10?"0":"")+string(t.month())+
        "-"+(t.day()<10?"0":"")+string(t.day());
    }
    function staffWorkingDay(dayId) {
      return dayId == malaysiaDate(0) ||
        (dayId == malaysiaDate(1)
          && (request.time+duration.value(8,'h')).hours() < 6);
    }
    function signedIn() {
      return request.auth != null;
    }
    function staffRoleStillReserved() {
      // A blocked employee still belongs to Staff. Only removed=true releases
      // the identity for a new Owner registration.
      return signedIn() && (
        (exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
            .data.get("removed",false) != true)
        || (request.auth.token.email is string
          && exists(/databases/$(database)/documents/staffEmails/$(request.auth.token.email))
          && get(/databases/$(database)/documents/staffEmails/$(request.auth.token.email))
            .data.get("removed",false) != true)
      );
    }
    function owner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid
        && !staffRoleStillReserved();
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function inviteMatch(inviteId, ownerUid, branchId) {
      return exists(/databases/$(database)/documents/staffInvites/$(inviteId))
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.branchId == branchId
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/staffInvites/$(inviteId)).data.active == true;
    }
    function member(ownerUid, branchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/members/$(request.auth.uid)).data.get("removed",false) == false;
    }

    function afterLiveOrder(ownerUid,branchId,orderId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/liveOrders/$(orderId)).data;
    }
    function afterDay(ownerUid,branchId,dayId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/daily/$(dayId)).data;
    }
    function afterInventory(ownerUid,branchId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/live/current).data;
    }
    function validStockItem(oldStock,newStock,qty,action,i) {
      return i >= oldStock.size()
        || (qty[i] is int && qty[i] >= 0
          && newStock[i] is int && newStock[i] >= 0
          && newStock[i] == oldStock[i]
             + (i == 4 ? 0 : (action == "CANCEL" ? qty[i] : -qty[i])));
    }
    function validStockMovement(oldStock,newStock,qty,action) {
      return oldStock is list && newStock is list && qty is list
        && oldStock.size() == newStock.size() && qty.size() == oldStock.size()
        && oldStock.size() <= 30
      && validStockItem(oldStock,newStock,qty,action,0)
      && validStockItem(oldStock,newStock,qty,action,1)
      && validStockItem(oldStock,newStock,qty,action,2)
      && validStockItem(oldStock,newStock,qty,action,3)
      && validStockItem(oldStock,newStock,qty,action,4)
      && validStockItem(oldStock,newStock,qty,action,5)
      && validStockItem(oldStock,newStock,qty,action,6)
      && validStockItem(oldStock,newStock,qty,action,7)
      && validStockItem(oldStock,newStock,qty,action,8)
      && validStockItem(oldStock,newStock,qty,action,9)
      && validStockItem(oldStock,newStock,qty,action,10)
      && validStockItem(oldStock,newStock,qty,action,11)
      && validStockItem(oldStock,newStock,qty,action,12)
      && validStockItem(oldStock,newStock,qty,action,13)
      && validStockItem(oldStock,newStock,qty,action,14)
      && validStockItem(oldStock,newStock,qty,action,15)
      && validStockItem(oldStock,newStock,qty,action,16)
      && validStockItem(oldStock,newStock,qty,action,17)
      && validStockItem(oldStock,newStock,qty,action,18)
      && validStockItem(oldStock,newStock,qty,action,19)
      && validStockItem(oldStock,newStock,qty,action,20)
      && validStockItem(oldStock,newStock,qty,action,21)
      && validStockItem(oldStock,newStock,qty,action,22)
      && validStockItem(oldStock,newStock,qty,action,23)
      && validStockItem(oldStock,newStock,qty,action,24)
      && validStockItem(oldStock,newStock,qty,action,25)
      && validStockItem(oldStock,newStock,qty,action,26)
      && validStockItem(oldStock,newStock,qty,action,27)
      && validStockItem(oldStock,newStock,qty,action,28)
      && validStockItem(oldStock,newStock,qty,action,29);
    }
    function staffInventoryChange(ownerUid,branchId) {
      let id = request.resource.data.lastOrderId;
      let action = request.resource.data.lastStockAction;
      let nextOrder = afterLiveOrder(ownerUid,branchId,id);
      return member(ownerUid,branchId)
        && id is string && action in ["RESERVE","CANCEL"]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["stock","lastOrderId","lastStockAction","updatedAt"])
        && nextOrder.actorUid == request.auth.uid
        && nextOrder.ownerUid == ownerUid
        && nextOrder.branchId == branchId
        && ((action == "RESERVE" && nextOrder.status == "PENDING")
           || (action == "CANCEL" && nextOrder.status == "CANCELLED"))
        && validStockMovement(resource.data.stock,request.resource.data.stock,nextOrder.qty,action);
    }
    function staffPayDay(ownerUid,branchId) {
      let id = request.resource.data.lastPaymentId;
      let receipt = afterLiveOrder(ownerUid,branchId,id);
      return member(ownerUid,branchId)
        && receipt.actorUid == request.auth.uid
        && receipt.status == "PAID"
        && receipt.ownerUid == ownerUid && receipt.branchId == branchId
        && request.resource.data.sales == resource.data.get("sales",0) + receipt.total
        && request.resource.data.transactions == resource.data.get("transactions",0) + 1
        && request.resource.data.cash == resource.data.get("cash",0)
           + (receipt.method == "Tunai" ? receipt.total : 0)
        && request.resource.data.qr == resource.data.get("qr",0)
           + (receipt.method == "Tunai" ? 0 : receipt.total)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["sales","transactions","cash","qr","lastPaymentId","businessDay","updatedAt"]);
    }

    function staffRefundDay(ownerUid,branchId) {
      let id = request.resource.data.lastRefundId;
      let receipt = afterLiveOrder(ownerUid,branchId,id);
      let approval = getAfter(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/refundRequests/$(receipt.refundApprovalId)).data;
      return member(ownerUid,branchId)
        && receipt.status == "REFUNDED"
        && receipt.actorUid == request.auth.uid
        && receipt.refundBy == request.auth.uid
        && approval.employeeUid == request.auth.uid
        && approval.status == "CLAIMED"
        && approval.amount == receipt.total
        && request.resource.data.sales == resource.data.get("sales",0) - receipt.total
        && request.resource.data.transactions == resource.data.get("transactions",0)
        && request.resource.data.cash == resource.data.get("cash",0)
           - (receipt.method == "Tunai" ? receipt.total : 0)
        && request.resource.data.qr == resource.data.get("qr",0)
           - (receipt.method == "Tunai" ? 0 : receipt.total)
        && request.resource.data.sales >= 0
        && request.resource.data.cash >= 0
        && request.resource.data.qr >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["sales","cash","qr","lastRefundId","updatedAt"]);
    }
    // Backward-compatible Google backup for older single-store accounts.
    match /users/{uid}/warisanpos/{document} {
      allow read, write: if owner(uid);
    }
    match /workspaces/{ownerUid} {
      allow read: if owner(ownerUid);
      allow create: if owner(ownerUid)
        && request.resource.data.ownerUid == ownerUid;
      allow update, delete: if owner(ownerUid);

      match /branches/{branchId} {
        allow read: if owner(ownerUid) || member(ownerUid, branchId);
        allow create: if owner(ownerUid)
          && request.resource.data.ownerUid == ownerUid;
        allow update, delete: if owner(ownerUid);

        match /members/{userUid} {
          allow get, list: if owner(ownerUid) || (signedIn() && request.auth.uid == userUid);
          allow create: if owner(ownerUid) ||
            (verifiedEmail() && request.auth.uid == userUid
              && request.resource.data.uid == userUid
              && request.resource.data.email == request.auth.token.email
              && request.resource.data.role == 'STAFF'
              && request.resource.data.active == true
              && request.resource.data.invitationId is string
              && inviteMatch(request.resource.data.invitationId,ownerUid,branchId));
          allow update, delete: if owner(ownerUid);
        }
        // Owner-only corrections to server inventory. Never a worker operation.
        match /stockAdjustments/{adjustmentId} {
          allow get, list: if owner(ownerUid);
          allow create: if owner(ownerUid)
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.type == "OWNER_CORRECTION"
            && request.resource.data.item is int
            && request.resource.data.before is number
            && request.resource.data.after is number
            && request.resource.data.difference is number
            && request.resource.data.difference ==
              request.resource.data.after-request.resource.data.before
            && request.resource.data.keys().hasOnly([
              "ownerUid","branchId","actorUid","item","name","before","after",
              "difference","type","createdAt"]);
          allow update, delete: if false;
        }
        match /live/{docId} {
          allow read: if owner(ownerUid) || member(ownerUid,branchId);
          allow create: if owner(ownerUid) && docId == "current"
            && request.resource.data.ownerUid == ownerUid;
          allow update: if docId == "current"
            && (owner(ownerUid) || staffInventoryChange(ownerUid,branchId));
          allow delete: if false;
        }
        match /daily/{dayId} {
          allow get: if owner(ownerUid) || (member(ownerUid,branchId) && staffWorkingDay(dayId));
          allow list: if owner(ownerUid);
          allow create: if owner(ownerUid) || (
            member(ownerUid,branchId)
            && request.resource.data.lastPaymentId is string
            && request.resource.data.businessDay == dayId
            && request.resource.data.sales == afterLiveOrder(ownerUid,branchId,request.resource.data.lastPaymentId).total
            && request.resource.data.transactions == 1
            && afterLiveOrder(ownerUid,branchId,request.resource.data.lastPaymentId).status == "PAID"
            && afterLiveOrder(ownerUid,branchId,request.resource.data.lastPaymentId).actorUid == request.auth.uid
            && request.resource.data.cash == (afterLiveOrder(ownerUid,branchId,request.resource.data.lastPaymentId).method == "Tunai" ?
              request.resource.data.sales : 0)
            && request.resource.data.qr == (afterLiveOrder(ownerUid,branchId,request.resource.data.lastPaymentId).method == "Tunai" ?
              0 : request.resource.data.sales)
          );
          allow update: if owner(ownerUid) || staffPayDay(ownerUid,branchId) || staffRefundDay(ownerUid,branchId);
          allow delete: if false;
        }
        match /liveOrders/{orderId} {
          allow get: if owner(ownerUid) ||
            (member(ownerUid,branchId) && resource.data.actorUid == request.auth.uid);
          allow list: if owner(ownerUid) ||
            (member(ownerUid,branchId) && resource.data.actorUid == request.auth.uid);
          allow create: if (owner(ownerUid) || member(ownerUid,branchId))
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.deviceOrderId == orderId
            && request.resource.data.total is int
            && request.resource.data.total > 0
            && request.resource.data.qty is list
            && request.resource.data.qty.size() <= 30
            && request.resource.data.status == "PENDING"
            && afterInventory(ownerUid,branchId).lastOrderId == orderId
            && afterInventory(ownerUid,branchId).lastStockAction == "RESERVE";
          allow update: if owner(ownerUid) ||
            (member(ownerUid,branchId)
              && resource.data.actorUid == request.auth.uid
              && request.resource.data.actorUid == resource.data.actorUid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","method","paidAt","cancelledAt"])
              && resource.data.status == "PENDING"
              && ((request.resource.data.status == "CANCELLED"
                    && afterInventory(ownerUid,branchId).lastOrderId == orderId
                    && afterInventory(ownerUid,branchId).lastStockAction == "CANCEL")
                 || (request.resource.data.status == "PAID"
                    && afterDay(ownerUid,branchId,resource.data.day).lastPaymentId == orderId)))
            || (member(ownerUid,branchId)
              && resource.data.actorUid == request.auth.uid
              && resource.data.status == "PAID"
              && request.resource.data.status == "REFUNDED"
              && request.resource.data.refundBy == request.auth.uid
              && request.resource.data.refundApprovalId is string
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","refundBy","refundApprovalId","refundedAt"])
              && getAfter(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId)/refundRequests/$(request.resource.data.refundApprovalId)).data.status == "CLAIMED"
              && afterDay(ownerUid,branchId,resource.data.day).lastRefundId == orderId);
          allow delete: if false;
        }
        // One-time foreground location check records; only Owner may list.
        // Coordinates are intentionally NOT stored (distance/status only).
        match /openingChecks/{checkId} {
          allow get, list: if owner(ownerUid);
          allow create: if member(ownerUid,branchId)
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.day is string
            && request.resource.data.status in
              ["VERIFIED","OUTSIDE_BRANCH","GPS_UNAVAILABLE",
               "NOT_CONFIGURED","MOCK_LOCATION","BRANCH_CLOSED"]
            && request.resource.data.distanceMeters is int
            && request.resource.data.keys().hasOnly([
              "ownerUid","branchId","employeeUid","day","status",
              "distanceMeters","createdAt"]);
          allow update, delete: if false;
        }
        match /staffLogins/{eventId} {
          allow get, list: if owner(ownerUid);
          allow create: if member(ownerUid,branchId)
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly([
              "ownerUid","branchId","employeeUid","email","deviceTag",
              "createdAt"]);
          allow update, delete: if false;
        }
        match /liveSessions/{dayId} {
          allow get: if owner(ownerUid) || (member(ownerUid,branchId) && staffWorkingDay(dayId));
          allow list: if owner(ownerUid);
          allow create: if owner(ownerUid) ||
            (member(ownerUid,branchId)
              && get(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId))
                .data.get("openingEnabled",true) == true
              && request.resource.data.ownerUid == ownerUid
              && request.resource.data.branchId == branchId
              && request.resource.data.day == dayId
              && (request.resource.data.openedBy == request.auth.uid
                || request.resource.data.closedBy == request.auth.uid)
              && request.resource.data.get("openedByEmail",request.auth.token.email) ==
                request.auth.token.email);
          allow update: if owner(ownerUid) ||
            (member(ownerUid,branchId)
              && resource.data.ownerUid == ownerUid
              && resource.data.branchId == branchId
              && request.resource.data.ownerUid == ownerUid
              && request.resource.data.branchId == branchId
              && request.resource.data.day == dayId
              && (request.resource.data.open == false ||
                get(/databases/$(database)/documents/workspaces/$(ownerUid)/branches/$(branchId))
                  .data.get("openingEnabled",true) == true)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["open","opening","closing","openedBy","closedBy",
                          "openedByEmail","closedByEmail","updatedAt"])
              && (request.resource.data.openedBy == request.auth.uid
                || request.resource.data.closedBy == request.auth.uid))
              && request.resource.data.get("openedByEmail",request.auth.token.email) ==
                request.auth.token.email
              && request.resource.data.get("closedByEmail",request.auth.token.email) ==
                request.auth.token.email);

          allow delete: if false;
        }
        // Refund requests: staff may request; ONLY Owner may approve/deny.
        // Staff may claim an approved refund once and finalize its status.
        match /refundRequests/{requestId} {
          allow get, list: if owner(ownerUid) ||
            (member(ownerUid,branchId) && resource.data.employeeUid == request.auth.uid);
          allow create: if member(ownerUid,branchId)
            && request.resource.data.ownerUid == ownerUid
            && request.resource.data.branchId == branchId
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.employeeEmail == request.auth.token.email
            && request.resource.data.status == "PENDING"
            && request.resource.data.amount is int
            && request.resource.data.amount > 0
            && request.resource.data.businessDay is string
            && request.resource.data.saleFingerprint is string
            && request.resource.data.receipt is string
            && request.resource.data.keys().hasOnly([
              "ownerUid", "branchId", "employeeUid", "employeeEmail",
              "businessDay","saleFingerprint","receipt","amount","status","requestedAt"
            ]);
          allow update: if
            (owner(ownerUid)
              && resource.data.status == "PENDING"
              && request.resource.data.status in ["APPROVED", "DENIED"]
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","decidedBy","decidedAt"]))
            ||
            (member(ownerUid,branchId)
              && resource.data.employeeUid == request.auth.uid
              && resource.data.status == "APPROVED"
              && request.resource.data.status == "CLAIMED"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","claimedAt"]))
            ||
            (member(ownerUid,branchId)
              && resource.data.employeeUid == request.auth.uid
              && resource.data.status == "CLAIMED"
              && request.resource.data.status == "COMPLETED"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status","completedAt"]));
          allow delete: if false;
        }
        // Only Owner can restore/overwrite a full POS backup.
        // Shared transactions will be introduced later as append-only documents.
        match /backups/{document} {
          allow read, write: if owner(ownerUid);
        }
      }
    }
    // Spark-only onboarding: Owner uses a secondary FirebaseAuth account to create
    // worker credentials, while writing a worker profile under Owner authorization.
    // Cross-provider reservation of worker EMAIL: a Google sign-in using
    // the same worker email cannot register another Owner workspace.
    match /staffEmails/{email} {
      allow get: if signedIn() &&
        (request.auth.token.email == email ||
          (resource != null && resource.data.ownerUid == request.auth.uid));
      allow list: if false;
      allow create: if signedIn() && owner(request.auth.uid)
        && request.resource.data.email == email
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role == "STAFF"
        && request.resource.data.workerUid is string
        && request.resource.data.branchId is string
        && request.resource.data.removed is bool
        && getAfter(/databases/$(database)/documents/staffProfiles/$(request.resource.data.workerUid)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/staffProfiles/$(request.resource.data.workerUid)).data.email == email
        && getAfter(/databases/$(database)/documents/staffProfiles/$(request.resource.data.workerUid)).data.branchId == request.resource.data.branchId
        && getAfter(/databases/$(database)/documents/staffProfiles/$(request.resource.data.workerUid)).data.get("removed",false) == request.resource.data.removed
        && request.resource.data.keys().hasOnly([
          "email","ownerUid","workerUid","branchId","role","removed","updatedAt"]);
      allow update: if owner(resource.data.ownerUid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.workerUid == resource.data.workerUid
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.role == "STAFF"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["removed","updatedAt"])
        && getAfter(/databases/$(database)/documents/staffProfiles/$(resource.data.workerUid)).data.get("removed",false) == request.resource.data.removed;
      allow delete: if false;
    }
    match /staffProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
        || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "STAFF"
        && request.resource.data.active == true
        && request.resource.data.email is string
        && request.resource.data.branchId is string
        && exists(/databases/$(database)/documents/workspaces/$(request.auth.uid)/branches/$(request.resource.data.branchId))
        && request.resource.data.keys().hasOnly([
          "uid","email","role","active","ownerUid",
          "branchId","branchName","createdAt"]);
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == "STAFF"
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["active","removed","removedAt","updatedAt","deviceId","deviceBoundAt"])
        && (!request.resource.data.get("removed",false)
          || request.resource.data.active == false)
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.role == "STAFF"
          && resource.data.active == true
          && resource.data.get("removed",false) == false
          && resource.data.get("deviceId","") == ""
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() >= 30
          && request.resource.data.deviceId.size() <= 128
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["deviceId","deviceBoundAt"]));
      allow delete: if false;
    }
    // Legacy Google invitation writes are disabled; email/password staff
    // accounts are provisioned on the free Spark plan by the Owner app.
    match /staffInvites/{inviteId} {
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
        resource.data.email == request.auth.token.email);
      allow create, update, delete: if false;
    }
  }
}